# MoveMigo .gitignore

# Dependencies
/vendor/
/node_modules/
composer.lock

# Configuration files with sensitive data
config/database.php
.env
*.env
*.env.local

# Logs
*.log
logs/
error_log

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# XAMPP specific
htdocs/
*.sql.bak

# Temporary files
*.tmp
*.temp
*.cache
*.bak
*.backup

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# PHP specific
*.php~
*.php.bak
php_errors.log

# Session files
sessions/

# Upload directories (if you have user uploads)
uploads/
images/uploads/

# Database dumps (keep structure, ignore data dumps)
*.sql
!database_setup.sql
!websocket_messaging_setup.sql

# Test files (optional - remove if you want to include tests)
test-*.php

# Composer
composer.phar

